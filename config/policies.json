{
  "policies": [
    {
      "name": "keycloak-jwt-auth",
      "policyType": "open-id-jwt-auth-inbound",
      "handler": {
        "export": "OpenIdJwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "issuerUrl": "$env(KEYCLOAK_ISSUER_URL)",
          "audience": "$env(LITELLM_JWT_AUDIENCE)",
          "jwkUrl": "$env(KEYCLOAK_JWKS_URL)"
        }
      }
    }
  ]
}
