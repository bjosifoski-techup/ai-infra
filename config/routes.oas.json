          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": { "type": "string" },
                  "location": { "type": "string" },
                  "startDate": { "type": "string", "description": "YYYY-MM-DD" },
                  "pageSize": { "type": "integer", "default": 10 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Event results" },
          "400": { "description": "Invalid request" },
          "401": { "description": "JWT missing or invalid" }
        }
      }
    },
    "/travel/viator/search": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Search tours and experiences via Viator",
        "operationId": "viator-search",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "default",
            "module": "$import(./modules/viator)"
          },
          "policies": {
            "inbound": ["keycloak-jwt-auth"]
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["destination"],
                "properties": {
                  "destination": { "type": "string" },
                  "query": { "type": "string" },
                  "pageSize": { "type": "integer", "default": 10 },
                  "currency": { "type": "string", "default": "USD" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Experience results" },
          "400": { "description": "Invalid request" },
          "401": { "description": "JWT missing or invalid" }
        }
      }
    },
    "/travel/stubhub/search": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Search tickets via StubHub",
        "operationId": "stubhub-search",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "default",
            "module": "$import(./modules/stubhub)"
          },
          "policies": {
            "inbound": ["keycloak-jwt-auth"]
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
