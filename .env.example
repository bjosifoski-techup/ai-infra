# =============================================================================
# Emerico AI Infrastructure — Environment Variables
# =============================================================================
#
# LEGEND
# ------
# [SET-UP]   → You create or generate this value yourself during deployment.
#              Comes from a system you control (Keycloak, LiteLLM, Atlas, Zuplo).
#              No procurement needed — you decide the value.
# [EXTERNAL] → You must obtain this from a third party (a partner API provider,
#              an affiliate program, or the client, Emerico).
#              *** Apply for ALL [EXTERNAL] keys at project kickoff.
#              *** Affiliate IDs and several partner keys require account approval
#              *** with significant lead time.
#
# [secret]   → Sensitive. Never log, never expose. Store in Elestio / Zuplo
#              environment secrets or a dedicated secret manager.
# [config]   → Non-sensitive value. Still loaded from env — never hard-code.
#
# OPERATOR CREDENTIALS (NOT in this file)
# ----------------------------------------
# Elestio dashboard login (email + password) — keep in a password manager only.
# Zuplo dashboard login (email + password)   — keep in a password manager only.
# These are human logins, not application secrets, and must not appear here.
#
# USAGE
# -----
# cp .env.example .env
# Fill in all values in .env. The .env file is gitignored — never commit it.
# =============================================================================


# =============================================================================
# ZUPLO — API Gateway & MCP host
# =============================================================================

# [SET-UP][secret] Generate in your Zuplo account → project settings.
# Used by the Zuplo CLI / git deploy pipeline.
ZUPLO_API_KEY=your-zuplo-api-key-here

# [SET-UP][config] Name you chose for the Zuplo gateway project.
ZUPLO_PROJECT_NAME=emerico-ai-gateway

# [SET-UP][secret] Service key you generate so the chat layer can call the gateway.
ZUPLO_GATEWAY_API_KEY=your-zuplo-gateway-api-key-here

# [SET-UP][config] Public base URL of your deployed Zuplo MCP gateway.
ZUPLO_MCP_BASE_URL=https://your-project.zuplo.app


# =============================================================================
# KEYCLOAK — Identity Provider (dedicated instance on Elestio)
# Separate from the SSO project realm. Commerce Platform customer identity only.
# =============================================================================

# [SET-UP][secret] Admin console username — you choose at deployment.
KEYCLOAK_ADMIN_USER=admin

# [SET-UP][secret] Admin console password — you choose at deployment.
KEYCLOAK_ADMIN_PASSWORD="NtiV10UkHWVPy3N#!o#3"

# [SET-UP][config] Public URL of your Keycloak instance on Elestio.
# You get this from the Elestio service details page after Keycloak finishes deploying.
# It will look like: https://keycloak-abc123.vm.elestio.app
KEYCLOAK_BASE_URL=

# [SET-UP][config] Realm name you created.
KEYCLOAK_REALM=emerico-commerce

# [SET-UP][config] OIDC issuer URL for the realm; used to validate the iss claim.
# Fill in once you have KEYCLOAK_BASE_URL: {KEYCLOAK_BASE_URL}/realms/emerico-commerce
KEYCLOAK_ISSUER_URL=

# [SET-UP][config] JWKS endpoint of the realm. Used by LiteLLM, Zuplo, and memory API.
# Fill in once you have KEYCLOAK_ISSUER_URL: {KEYCLOAK_ISSUER_URL}/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=

# [SET-UP][config] Name of the JWT claim the protocol mapper puts the tier in.
# Already configured as "tier" in realm-export.json - do not change unless you rename the mapper.
KEYCLOAK_TIER_CLAIM=tier

# [SET-UP][config] Public OIDC client ID for the Vercel frontend (PKCE, no secret).
# Already created by the realm import.
KC_FRONTEND_CLIENT_ID=emerico-frontend

# [SET-UP][config] Resource-server client ID for LiteLLM.
# Already created by the realm import.
KC_LITELLM_CLIENT_ID=emerico-litellm

# [SET-UP][secret] Client secret - generated by Keycloak after realm import.
# Admin console > Clients > emerico-litellm > Credentials > Regenerate.
KC_LITELLM_CLIENT_SECRET=

# [SET-UP][config] Resource-server client ID for the Memory API.
# Already created by the realm import.
KC_MEMORY_CLIENT_ID=emerico-memory-api

# [SET-UP][secret] Client secret - generated by Keycloak after realm import.
# Admin console > Clients > emerico-memory-api > Credentials > Regenerate.
KC_MEMORY_CLIENT_SECRET=

# [SET-UP][config] Resource-server client ID for the Zuplo gateway.
# Already created by the realm import.
KC_ZUPLO_CLIENT_ID=emerico-zuplo

# [SET-UP][secret] Client secret - generated by Keycloak after realm import.
# Admin console > Clients > emerico-zuplo > Credentials > Regenerate.
KC_ZUPLO_CLIENT_SECRET=


# =============================================================================
# LITELLM — LLM Proxy (deployed on Elestio managed cloud)
# =============================================================================

# [SET-UP][secret] Master admin key — generate a strong random value (e.g. openssl rand -hex 32).
LITELLM_MASTER_KEY=sk-16ffa54dd89c667d25cd42cd5bbd27b5f5459850853b38ef

# [SET-UP][secret] Salt that encrypts stored credentials — generate once and never change.
LITELLM_SALT_KEY=fe14cac45a65f65e2ed4b3fa5014cc02bcd4861a9db087d8b94be2395492e6e7

# [SET-UP][secret] Postgres connection string provisioned automatically by Elestio alongside LiteLLM.
# After deploying LiteLLM on Elestio, open the service details page - the connection string is listed there.
# It will look like: postgresql://litellm:password@host:5432/litellm
LITELLM_DATABASE_URL=

# [SET-UP][secret] Username you choose to protect the LiteLLM admin UI.
LITELLM_UI_USERNAME=admin

# [SET-UP][secret] Password you choose to protect the LiteLLM admin UI.
LITELLM_UI_PASSWORD=0ywAEDjnwQzWAyCKBlxN

# [SET-UP][config] Expected aud claim value in tokens presented to LiteLLM.
# Must match KC_LITELLM_CLIENT_ID - do not change unless you rename the Keycloak client.
LITELLM_JWT_AUDIENCE=emerico-litellm

# [EXTERNAL][config] Endpoint of the client's self-hosted model.
# Request from Emerico at kickoff. Also confirm: is it OpenAI-compatible? Does it support tool calling?
SELF_HOSTED_LLM_BASE_URL=

# [EXTERNAL][secret] API key for the client's self-hosted model. Request from Emerico at kickoff.
SELF_HOSTED_LLM_API_KEY=


# =============================================================================
# MONGODB ATLAS — Memory Storage
# =============================================================================

# [SET-UP][secret] Programmatic API public key from your Atlas account (optional if cluster is manual).
ATLAS_API_PUBLIC_KEY=your-atlas-api-public-key-here

# [SET-UP][secret] Programmatic API private key from your Atlas account.
ATLAS_API_PRIVATE_KEY=your-atlas-api-private-key-here

# [SET-UP][secret] Least-privilege database user you create in Atlas (read/write this DB only).
MONGODB_DB_USER=emerico-memory-user

# [SET-UP][secret] Password you set for the database user in Atlas.
MONGODB_DB_PASSWORD=your-mongodb-password-here

# [SET-UP][secret] Full Atlas connection string (includes user + password above).
# Pattern: mongodb+srv://{MONGODB_DB_USER}:{MONGODB_DB_PASSWORD}@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://emerico-memory-user:your-mongodb-password-here@cluster.mongodb.net/

# [SET-UP][config] Database name for the memory collections.
MONGODB_DB_NAME=emerico-memory

# [SET-UP][config] Port the Memory API service listens on.
MEMORY_API_PORT=3001

# [SET-UP][config] Public base URL of the deployed Memory API service.
MEMORY_API_BASE_URL=https://your-memory-api.example.com

# [SET-UP][config] Expected aud claim value in tokens presented to the Memory API.
MEMORY_JWT_AUDIENCE=emerico-memory-api


# =============================================================================
# PARTNER APIS — Dropshipping
# *** ALL values in this section are [EXTERNAL] — apply at project kickoff.
# =============================================================================

# [EXTERNAL][secret] App key issued by AliExpress Open Platform developer console.
ALIEXPRESS_APP_KEY=532152

# [EXTERNAL][secret] App secret issued by AliExpress Open Platform.
ALIEXPRESS_APP_SECRET=AkW72yB1QJ7r7BVUMEaPBwXWpseQkfs1

# [EXTERNAL][secret] AliExpress affiliate tracking ID / PID — required for commission tracking.
ALIEXPRESS_TRACKING_ID=your-aliexpress-tracking-id-here

# [EXTERNAL][secret] REST API key issued by the BigBuy account dashboard.
BIGBUY_API_KEY=ZWE0NDk3NTIwYjU0MDc5YzdlOWY1ODFlODcwMDMwOTdjOGY2YjUyNmI1Y2VlOTUyZDhmOThiMjgzOTdiMjY1Mw

# [SET-UP][config] BigBuy environment: "sandbox" (default for the sandbox key
# above) or "production". A sandbox key sent to the prod host returns "Invalid
# Token", and a prod key sent to the sandbox host 401s — keep this aligned with
# whichever BIGBUY_API_KEY is set above. Mirrors the Commerce API convention.
BIGBUY_ENV=sandbox

# [SET-UP][secret] Your CJDropshipping account email (you chose it when registering).
# NOTE: verify whether CJ5293884 is the full email or just the account ID in their system
CJ_EMAIL=CJ5293884

# [EXTERNAL][secret] API key issued by CJDropshipping — used to obtain an access token.
CJ_API_KEY=4739200eeb7f4b13927dedcc0e0c23d5

# [EXTERNAL][secret] Short-lived access token returned by the CJDropshipping API.
# Refreshed programmatically using CJ_API_KEY. Seed with an initial value if required.
CJ_ACCESS_TOKEN=your-cj-access-token-here


