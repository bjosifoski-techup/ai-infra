#   private/org-scoped token: V3XE2KQAHUIJJIDQJMJB
#   API key:                  M7AP5XSJU6BMVY2NTG
#   client secret:            4YUKKTFZGPQFMMYWT34D4FBLFX4GZU4EH6R3DOKZQLKCJAEF3N
EVENTBRITE_TOKEN=ZD2KSL54I6OQK62YBSJL

# [EXTERNAL][secret] Affiliate code issued by Eventbrite, appended to every event deep link.
